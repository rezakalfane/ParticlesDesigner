{
  "name": "@absolumont/particles-designer",
  "version": "0.1.1",
  "type": "module",
  "description": "Luminous GPU particle fields for any web page: <particle-field> element and ParticleField API, with the Particles Designer (WebGL2, audio-reactive, AI-authored looks).",
  "author": "Reza Kalfane, Absolumont Collective",
  "license": "MIT",
  "homepage": "https://rezakalfane.github.io/ParticlesDesigner/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rezakalfane/ParticlesDesigner.git"
  },
  "bugs": {
    "url": "https://github.com/rezakalfane/ParticlesDesigner/issues"
  },
  "keywords": [
    "particles",
    "webgl2",
    "web-component",
    "audio-reactive",
    "generative",
    "visualizer",
    "shader",
    "animation",
    "background",
    "roto-control",
    "midi"
  ],
  "exports": {
    ".": {
      "types": "./dist-embed/types/embed/index.d.ts",
      "import": "./dist-embed/particles-designer.js"
    }
  },
  "module": "./dist-embed/particles-designer.js",
  "types": "./dist-embed/types/embed/index.d.ts",
  "jsdelivr": "./dist-embed/particles-designer.iife.js",
  "unpkg": "./dist-embed/particles-designer.iife.js",
  "files": [
    "dist-embed",
    "roto/*.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:embed": "vite build --config vite.embed.config.ts && tsc -p tsconfig.embed.json",
    "build:site": "npm run build && npm run build:embed && node scripts/build-site.mjs",
    "examples": "npm run build:embed && vite --open /examples/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run typecheck && npm run test && npm run build && npm run build:embed",
    "roto:presets": "tsx scripts/generate-roto-presets.ts",
    "bake": "tsx scripts/bake-library.ts",
    "rehearse:roto": "node scripts/rehearse-roto.mjs",
    "rehearse:embed": "node scripts/rehearse-embed.mjs",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
