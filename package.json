{
  "name": "particles-designer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ABSOLUMONT Particles Designer — author GPU particle fields (WebGL2) with presets, shapes, AI prompts and ROTO-CONTROL.",
  "author": "Reza Kalfane, Absolumont Collective",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run typecheck && npm run test && npm run build",
    "roto:presets": "tsx scripts/generate-roto-presets.ts",
    "bake": "tsx scripts/bake-library.ts",
    "rehearse:roto": "node scripts/rehearse-roto.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
